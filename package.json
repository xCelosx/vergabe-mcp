{
  "name": "vergabe-mcp",
  "version": "1.1.0",
  "description": "MCP server for German and EU public-procurement data (BKMS / oeffentlichevergabe.de + TED Europa). Four tools: unified notice search, full notice detail with PDF text extraction, buyer history, and document download (v2.0).",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "vergabe-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-desktop",
    "vergabe",
    "tender",
    "ausschreibung",
    "bkms",
    "ted",
    "oeffentlichevergabe",
    "ocds",
    "eforms",
    "public-procurement",
    "germany",
    "eu",
    "procurement"
  ],
  "author": "Florentin Bernhardt <florentin@florentinbernhardt.de> (https://florentinbernhardt.de)",
  "license": "MIT",
  "homepage": "https://florentinbernhardt.de/vault",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xCelosx/vergabe-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/xCelosx/vergabe-mcp/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.7.0",
    "jszip": "^3.10.1",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^4.10.0",
    "xml2js": "^0.6.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/xml2js": "^0.4.14",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
